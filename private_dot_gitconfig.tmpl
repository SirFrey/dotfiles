[user]
	email = {{ .email }}
	user = {{ .user }}
	name = {{ .name }}
[init]
	defaultBranch = main
[core]
	# Paging stays off (as before); delta only adds syntax highlighting and line
	# numbers. Falls back to plain output where delta isn't on PATH.
	pager = command -v delta >/dev/null 2>&1 && exec delta --paging=never || exec cat
[interactive]
	diffFilter = command -v delta >/dev/null 2>&1 && exec delta --color-only || exec cat
[delta]
	line-numbers = true
[color]
	ui = true
[color "diff-highlight"]
	oldNormal = red bold
	oldHighlight = red bold 52
	newNormal = green bold
	newHighlight = green bold 22
[color "diff"]
	meta = 11
	frag = magenta bold
	func = 146 bold
	commit = yellow bold
	old = red bold
	new = green bold
	whitespace = red reverse

[push]
  autoSetupRemote = true
