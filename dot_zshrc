# Report cwd to the terminal via OSC 7 so WezTerm tracks each tab's directory.
# starship no longer emits this itself, so register our own precmd hook (zsh
# allows multiple precmd functions, so this coexists with starship's hooks).
_wezterm_osc7_cwd() { printf '\033]7;file://%s%s\033\\' "${HOST}" "${PWD}" }
autoload -Uz add-zsh-hook
add-zsh-hook precmd _wezterm_osc7_cwd

# OSC 133 shell-integration marks (prompt start, command start, command end +
# exit code). tmux 3.8 turns these into pane-command-finished events and copy
# mode next-prompt/previous-prompt; WezTerm uses them for semantic zones.
# The precmd must run FIRST, before starship/others overwrite $?.
_osc133_preexec() { _osc133_running=1; printf '\033]133;C\033\\' }
_osc133_precmd() {
  local ret=$?
  (( _osc133_running )) && printf '\033]133;D;%s\033\\' "$ret"
  _osc133_running=0
  printf '\033]133;A\033\\'
}
add-zsh-hook preexec _osc133_preexec
precmd_functions=(_osc133_precmd ${precmd_functions:#_osc133_precmd})

